<Window x:Class="EmployeeCRUD.SalarySlip"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       Title="Salary Slip"
Height="700"
Width="550"
WindowStartupLocation="CenterScreen"
ResizeMode="NoResize"
        Background="#EEF2F7">

    <Grid Margin="30">

        <Border Background="White"  CornerRadius="20"  Padding="40"  BorderBrush="#D9E2EC"  BorderThickness="1">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <TextBlock Text="SALARY SLIP" FontSize="36" FontWeight="Bold" Foreground="#102A43"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>

                    <Grid Margin="0,0,0,40">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Employee ID" FontWeight="Bold" FontSize="18" Grid.Row="0"/>

                        <TextBlock x:Name="txtId" FontSize="18" Grid.Row="0" Grid.Column="1"/>

                        <TextBlock Text="Employee Name" FontWeight="Bold" FontSize="18" Grid.Row="1"/>

                        <TextBlock x:Name="txtName" FontSize="18" Grid.Row="1" Grid.Column="1"/>

                        <TextBlock Text="Department" FontWeight="Bold" FontSize="18" Grid.Row="2"/>

                        <TextBlock x:Name="txtDept" FontSize="18" Grid.Row="2" Grid.Column="1"/>

                        <TextBlock Text="Joining Date" FontSize="18" FontWeight="Bold" Grid.Row="3"/>

                        <TextBlock x:Name="txtJoiningDate" FontSize="18" Grid.Row="3" Grid.Column="1"/>

                        <TextBlock Text="Basic Salary" FontWeight="Bold" FontSize="18" Grid.Row="4"/>

                        <TextBlock x:Name="txtBasic" FontSize="18" Grid.Row="4" Grid.Column="1"/>

                        <TextBlock Text="Salary Month" FontWeight="Bold" FontSize="18" Grid.Row="5"/>
                        
                        <TextBlock x:Name="txtMonth"   FontSize="18"     Grid.Row="5" Grid.Column="1"/>

                    </Grid>

                    <Border Background="#F8FAFC" CornerRadius="15" Padding="30" Margin="0,0,0,30">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="HRA (20%)"  FontSize="18"  FontWeight="SemiBold"  Grid.Row="0"/>

                            <TextBlock x:Name="txtHRA" FontSize="18" Grid.Row="0" Grid.Column="1"/>

                            <TextBlock Text="DA (10%)" FontSize="18" FontWeight="SemiBold" Grid.Row="1"/>

                            <TextBlock x:Name="txtDA" FontSize="18" Grid.Row="1" Grid.Column="1"/>

                            <TextBlock Text="PF (8%)" FontSize="18" FontWeight="SemiBold" Grid.Row="2"/>

                            <TextBlock x:Name="txtPF" FontSize="18" Grid.Row="2" Grid.Column="1"/>

                            <TextBlock Text="Tax (5%)" FontSize="18" FontWeight="SemiBold" Grid.Row="3"/>

                            <TextBlock x:Name="txtTax" FontSize="18" Grid.Row="3" Grid.Column="1"/>

                            <TextBlock Text="Gross Salary" FontSize="20"  FontWeight="Bold" Foreground="#2563EB"
                                       Grid.Row="4"/>

                            <TextBlock x:Name="txtGross" FontSize="20"  FontWeight="Bold" Foreground="#2563EB"
                                       Grid.Row="4" Grid.Column="1"/>

                            <TextBlock Text="Net Salary" FontSize="24" FontWeight="Bold" Foreground="#059669"
                                       Grid.Row="5"/>

                            <TextBlock x:Name="txtNet" FontSize="24" FontWeight="Bold" Foreground="#059669"
                                       Grid.Row="5" Grid.Column="1"/>
                        </Grid>

                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        
                        <Button Content="Back" Width="150" Height="45" Margin="10" Background="#2563EB" Foreground="White"
                                Click="Back_Click"/>

                    </StackPanel>

                </StackPanel>

            </ScrollViewer>

        </Border>

    </Grid>
</Window>