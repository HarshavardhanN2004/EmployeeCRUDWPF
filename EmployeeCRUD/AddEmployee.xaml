<Window x:Class="EmployeeCRUD.AddEmployee"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EmployeeCRUD"
        mc:Ignorable="d"

        Title="Add Employee"

        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Grid>

        <Border Width="500" Height="490" Background="White" CornerRadius="15" Padding="30" HorizontalAlignment="Center"
                VerticalAlignment="Center" BorderBrush="#D0D7DE" BorderThickness="2">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Add Employee" Grid.Row="0" Grid.ColumnSpan="2" FontSize="28" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,25" Foreground="#1E3A5F"/>

                <TextBlock Text="Name:" Grid.Row="1" VerticalAlignment="Center" FontSize="16"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="txtName" Grid.Row="1" Grid.Column="1" Height="35" Margin="10"/>

                <TextBlock Text="Age:"  Grid.Row="2"  VerticalAlignment="Center"  FontSize="16"  FontWeight="SemiBold"/>

                <TextBox x:Name="txtAge" Grid.Row="2" Grid.Column="1" Height="35" Margin="10"/>

                <TextBlock Text="Department:" Grid.Row="3" VerticalAlignment="Center" FontSize="16"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="txtDept" Grid.Row="3" Grid.Column="1" Height="35" Margin="10"/>

                <TextBlock Text="Joining Date:" Grid.Row="4" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>

                <DatePicker x:Name="dpJoiningDate" Grid.Row="4" Grid.Column="1" Margin="10" Height="35"/>

                <TextBlock Text="Salary:" Grid.Row="5" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>

                <TextBox x:Name="txtSalary" Grid.Row="5" Grid.Column="1" Height="35" Margin="10"/>

                <Button Content="Save" Grid.Row="6" Grid.ColumnSpan="2" Width="140" Height="40" Margin="65,13,0,12"
                        HorizontalAlignment="Left" Background="#2563EB" Foreground="White" FontSize="15"
                        FontWeight="Bold" BorderThickness="0" Click="Save_Click"/>

                <Button Content="Close" Grid.Row="6" Width="140" Height="40" Margin="121,13,0,12"
                         HorizontalAlignment="Left" Background="Red" Foreground="White" FontSize="15"
                          FontWeight="Bold" BorderThickness="0" Click="Close_Click" Grid.Column="1"/>
            </Grid>

        </Border>

    </Grid>
</Window>