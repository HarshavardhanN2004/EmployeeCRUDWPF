<Window x:Class="EmployeeCRUD.SalaryByDepartment"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Salary By Department"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Salary By Department" Grid.Row="0"
                   FontSize="30" FontWeight="Bold" Foreground="#1E3A5F"
                   HorizontalAlignment="Center" Margin="0,20,0,25"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,0,0,25">

            <TextBox x:Name="txtDepartment" Width="300" Height="38"
                     Margin="10" FontSize="15"
                     ToolTip="Enter department name"/>

            <Button Content="Search" Width="140" Height="38" Margin="10"
                    Background="#2196F3" Foreground="White"
                    FontSize="15" FontWeight="Bold" BorderThickness="0"
                    Click="Search_Click"/>

            <Button Content="Close" Width="140" Height="38" Margin="10"
                    Background="Red" Foreground="White"
                    FontSize="15" FontWeight="Bold" BorderThickness="0"
                    Click="Close_Click"/>

        </StackPanel>

        <Border Grid.Row="2" Background="White" CornerRadius="10"
                Padding="10" BorderBrush="#D0D7DE" BorderThickness="2">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <DataGrid x:Name="dataGrid" Grid.Row="1"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          FontSize="14" RowHeight="38"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#F8FAFC"
                          Background="White" BorderThickness="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Emp ID"      Binding="{Binding EmpId}"       Width="80"/>
                        <DataGridTextColumn Header="Name"        Binding="{Binding Name}"        Width="160"/>
                        <DataGridTextColumn Header="Department"  Binding="{Binding Department}"  Width="160"/>
                        <DataGridTextColumn Header="Month"       Binding="{Binding MonthName}"   Width="120"/>
                        <DataGridTextColumn Header="Year"        Binding="{Binding SalaryYear}"  Width="80"/>
                        <DataGridTextColumn Header="Working Days" Binding="{Binding WorkingDays}" Width="110"/>
                        <DataGridTextColumn Header="Basic"       Binding="{Binding BasicSalary}" Width="120"/>
                        <DataGridTextColumn Header="HRA"         Binding="{Binding HRA}"         Width="100"/>
                        <DataGridTextColumn Header="DA"          Binding="{Binding DA}"          Width="100"/>
                        <DataGridTextColumn Header="Gross"       Binding="{Binding GrossSalary}" Width="120"/>
                        <DataGridTextColumn Header="Deduction"   Binding="{Binding Deduction}"   Width="110"/>
                        <DataGridTextColumn Header="Net Salary"  Binding="{Binding NetSalary}"   Width="120"/>
                    </DataGrid.Columns>

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#2563EB"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Height" Value="45"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Foreground" Value="#102A43"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="8"/>
                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.CellStyle>

                </DataGrid>

            </Grid>

        </Border>

    </Grid>
</Window>