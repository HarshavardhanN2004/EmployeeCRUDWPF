<Window x:Class="EmployeeCRUD.Delete"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EmployeeCRUD"
        mc:Ignorable="d"

        Title="Delete Employee"

        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Grid>

        <Border Width="550" Height="300" Background="White" CornerRadius="15" Padding="30"
                HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#D0D7DE"
                BorderThickness="2">

            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="Delete Employee" FontSize="30" FontWeight="Bold"
                           Foreground="#B71C1C" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <TextBlock Text="Are you sure you want to delete this employee?"
                           FontSize="18" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="#333333" Margin="0,0,0,35"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <Button Content="Delete" Width="130" Height="42" Margin="15" Background="#F44336"
                            Foreground="White" FontSize="15" FontWeight="Bold"
                            BorderThickness="0" Click="Delete_Click"/>

                    <Button Content="Cancel" Width="130" Height="42" Margin="15" Background="#607D8B"
                            Foreground="White" FontSize="15" FontWeight="Bold" BorderThickness="0"
                            Click="Cancel_Click"/>

                </StackPanel>

            </StackPanel>

        </Border>

    </Grid>
</Window>