<Window x:Class="EmployeeCRUD.SelectMonth"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Month"
        Height="280" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#EEF2F7">

    <Grid>
        <Border Width="340" Height="320" Background="White" CornerRadius="15" Padding="30"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="#D0D7DE" BorderThickness="2">

            <StackPanel>

                <TextBlock Text="Select Salary Month" FontSize="20" FontWeight="Bold"
                           Foreground="#102A43" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">

                    <TextBlock Text="Month:" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <ComboBox x:Name="cmbMonth" Width="120" Height="35" FontSize="14"/>

                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,25">

                    <TextBlock Text="Year:" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <ComboBox x:Name="cmbYear" Width="120" Height="35" FontSize="14"/>

                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                    <Button Content="Proceed" Width="120" Height="38" Margin="10"
                            Background="#2563EB" Foreground="White" FontWeight="Bold"
                            BorderThickness="0" Click="Proceed_Click"/>

                    <Button Content="Cancel" Width="120" Height="38" Margin="10"
                            Background="Red" Foreground="White" FontWeight="Bold"
                            BorderThickness="0" Click="Cancel_Click"/>

                </StackPanel>

            </StackPanel>

        </Border>
    </Grid>
</Window>