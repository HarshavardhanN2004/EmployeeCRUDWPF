<Window x:Class="EmployeeCRUD.Search"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EmployeeCRUD"
        mc:Ignorable="d"

        Title="Search Employee"

        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Search Employee" FontSize="30" FontWeight="Bold" Foreground="#1E3A5F"
                   HorizontalAlignment="Center" Margin="0,20,0,25"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,25">

            <TextBox x:Name="txtSearch"  Width="300" Height="38" Margin="10" FontSize="15" ToolTip="Enter employee name"/>

            <Button Content="Search" Width="140" Height="38" Margin="10" Background="#2196F3" Foreground="White"
                    FontSize="15" FontWeight="Bold" BorderThickness="0" Click="Search_Click"/>

            <Button Content="Close" Width="140" Height="38" Margin="10" Background="Red" Foreground="White"
                    FontSize="15" FontWeight="Bold" BorderThickness="0" Click="Close_Click"/>

        </StackPanel>

        <Border Grid.Row="2" Width="1100" Height="550" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="White" CornerRadius="10" Padding="10" BorderBrush="#D0D7DE" BorderThickness="2">

            <DataGrid x:Name="dataGrid" AutoGenerateColumns="True" IsReadOnly="True"
                      FontSize="14" RowHeight="35" AlternatingRowBackground="#F3F6F9"/>
        </Border>

    </Grid>
</Window>