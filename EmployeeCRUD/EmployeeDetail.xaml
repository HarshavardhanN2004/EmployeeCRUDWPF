<Window x:Class="EmployeeCRUD.EmployeeDetails"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Employee Details"
        Height="500"
        Width="500"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#EEF2F7">

    <Grid Margin="20">

        <Border Background="White" CornerRadius="15" Padding="25" BorderBrush="#D9E2EC" BorderThickness="1">

            <StackPanel>

                <TextBlock Text="Employee Details" FontSize="28" FontWeight="Bold" Foreground="#102A43"
                           HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <TextBlock Text="Employee Name" FontSize="15" FontWeight="SemiBold"/>

                <TextBox x:Name="txtName" Height="35" Margin="0,5,0,15" FontSize="14" IsReadOnly="True"/>

                <TextBlock Text="Age" FontSize="15" FontWeight="SemiBold"/>

                <TextBox x:Name="txtAge" Height="35" Margin="0,5,0,15" FontSize="14" IsReadOnly="True"/>

                <TextBlock Text="Department" FontSize="15" FontWeight="SemiBold"/>

                <TextBox x:Name="txtDept" Height="35" Margin="0,5,0,15" FontSize="14" IsReadOnly="True"/>

                <TextBlock Text="Joining Date"  FontSize="15"  FontWeight="SemiBold"/>

                <TextBox x:Name="txtJoiningDate" Height="35" Margin="0,5,0,15" FontSize="14" IsReadOnly="True"/>

                <TextBlock Text="Salary" FontSize="15" FontWeight="SemiBold"/>

                <TextBox x:Name="txtSalary" Height="35" Margin="0,5,0,25" FontSize="14" IsReadOnly="True"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                    <Button Content="Update" Width="100" Height="40" Margin="10" Background="#2563EB" Foreground="White"
                            FontWeight="Bold" BorderThickness="0" Click="Update_Click"/>

                    <Button Content="Delete" Width="100" Height="40" Margin="10" Background="#DC2626" Foreground="White"
                            FontWeight="Bold" BorderThickness="0" Click="Delete_Click"/>

                    <Button Content="Back" Width="100" Height="40" Margin="10" Background="#6B7280" Foreground="White"
                            FontWeight="Bold" BorderThickness="0" Click="Back_Click"/>

                </StackPanel>

            </StackPanel>

        </Border>

    </Grid>
</Window>