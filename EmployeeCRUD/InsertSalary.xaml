<Window x:Class="EmployeeCRUD.InsertSalary"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Insert Salary"
        Height="540" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#EEF2F7">

    <Grid>
        <Border Width="480" Height="540" Background="White" CornerRadius="15" Padding="30"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="#D0D7DE" BorderThickness="2">

            <StackPanel>

                <TextBlock Text="Insert Salary" FontSize="22" FontWeight="Bold"
                           Foreground="#102A43" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Employee ID:" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtEmpId" Height="35" FontSize="14" Margin="0,0,0,15"/>

                <TextBlock Text="Month:" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="cmbMonth" Height="35" FontSize="14" Margin="0,0,0,15"/>

                <TextBlock Text="Year:" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="cmbYear" Height="35" FontSize="14" Margin="0,0,0,15"/>

                <TextBlock Text="Basic Salary:" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtSalary" Height="35" FontSize="14" Margin="0,0,0,15"/>

                <TextBlock Text="Working Days Present:" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtWorkingDays" Height="35" FontSize="14" Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                    <Button Content="Calculate &amp; Save" Width="150" Height="38" Margin="10"
                            Background="#2563EB" Foreground="White" FontWeight="Bold"
                            BorderThickness="0" Click="Save_Click"/>

                    <Button Content="Close" Width="100" Height="38" Margin="10"
                            Background="Red" Foreground="White" FontWeight="Bold"
                            BorderThickness="0" Click="Close_Click"/>

                </StackPanel>

            </StackPanel>

        </Border>
    </Grid>
</Window>